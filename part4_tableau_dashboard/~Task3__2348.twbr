      <aliases enabled='yes' />
      <column caption='Profit Margin' datatype='real' name='[Calculation_0161370531586048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([sales]) &lt;&gt; 0 THEN&#13;&#10;    SUM([profit]) / SUM([sales])&#13;&#10;END' />
      </column>
      <column caption='Cost' datatype='real' name='[Calculation_0161370532253697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[sales] - [profit]' />
      </column>
      <column caption='Average Order Value' datatype='real' name='[Calculation_0161370532634626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sales]) / COUNTD([order_id])' />
      </column>
      <column caption='Return Rate' datatype='real' name='[Calculation_0161370536923139]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [return_flag] = 1 THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([order_id])' />
      </column>
      <column caption='Shipping Delay' datatype='integer' name='[Calculation_0161370540589060]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[order_date],[ship_date])' />
      </column>
      <column caption='Shipping Days' datatype='integer' name='[Calculation_0161370540875781]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [order_date], [ship_date])' />
      </column>
      <column caption='Shipping Delay Bucket' datatype='string' name='[Calculation_0161370541699078]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0161370540875781] &lt;= 2 THEN&#13;&#10;    &quot;Fast (0-2 Days)&quot;&#13;&#10;ELSEIF [Calculation_0161370540875781] &lt;= 5 THEN&#13;&#10;    &quot;Standard (3-5 Days)&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Delayed (6+ Days)&quot;&#13;&#10;END' />
      </column>
      <column caption='Profit Category' datatype='string' name='[Calculation_0161370542100487]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [profit] &gt; 0 THEN&#13;&#10;    &quot;Profitable&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Loss&quot;&#13;&#10;END' />
      </column>
      <column caption='Discount Category' datatype='string' name='[Calculation_0161370542202888]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [discount] = 0 THEN&#13;&#10;    &quot;No Discount&quot;&#13;&#10;ELSEIF [discount] &lt;= 0.20 THEN&#13;&#10;    &quot;Low Discount&quot;&#13;&#10;ELSE&#13;&#10;    &quot;High Discount&quot;&#13;&#10;END' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_0161370569318409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='dashboard_sales_data' datatype='table' name='[__tableau_internal_object_id__].[dashboard!sales!data_249D2B78C29E4456AF014A93C0DB7E3E]' role='measure' type='quantitative' />
