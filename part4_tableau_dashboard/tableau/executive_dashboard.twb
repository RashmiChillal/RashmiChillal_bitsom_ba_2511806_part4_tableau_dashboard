          </datasources>
          <datasource-dependencies datasource='federated.1fhcfmo0vfdzpa1bjaeh11qxrtje'>
            <column caption='Shipping Days' datatype='integer' name='[Calculation_0161370540875781]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [order_date], [ship_date])' />
            </column>
            <column caption='Shipping Delay Bucket' datatype='string' name='[Calculation_0161370541699078]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0161370540875781] &lt;= 2 THEN&#13;&#10;    &quot;Fast (0-2 Days)&quot;&#13;&#10;ELSEIF [Calculation_0161370540875781] &lt;= 5 THEN&#13;&#10;    &quot;Standard (3-5 Days)&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Delayed (6+ Days)&quot;&#13;&#10;END' />
            </column>
            <column-instance column='[Calculation_0161370540875781]' derivation='Avg' name='[avg:Calculation_0161370540875781:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0161370541699078]' derivation='None' name='[none:Calculation_0161370541699078:nk]' pivot='key' type='nominal' />
            <column-instance column='[ship_mode]' derivation='None' name='[none:ship_mode:nk]' pivot='key' type='nominal' />
            <column caption='Order Date' datatype='date' name='[order_date]' role='dimension' type='ordinal' />
            <column caption='Ship Date' datatype='date' name='[ship_date]' role='dimension' type='ordinal' />
            <column caption='Ship Mode' datatype='string' name='[ship_mode]' role='dimension' type='nominal' />
